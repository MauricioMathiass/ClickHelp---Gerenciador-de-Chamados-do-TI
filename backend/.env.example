PORT=3001
# Origens permitidas no CORS (separe por vírgula)
FRONTEND_ORIGIN=http://localhost:5173
# Fuso usado no cálculo do SLA (horário comercial)
TZ=America/Sao_Paulo
# Segredo para assinar os tokens de login (mínimo de 32 caracteres).
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
# Administrador inicial (os demais usuários são cadastrados pelo sistema)
ADMIN_USERNAME=administrador
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NAME=Administrador
ADMIN_DEPARTMENT=TI
# Banco PostgreSQL (ex.: Neon). Use a connection string da branch "dev" para
# desenvolver. Sem esta linha, o backend usa um banco local embutido em
# DATA_DIR/pgdata, bom para testar sem configurar nada.
# DATABASE_URL=postgresql://usuario:senha@servidor/banco?sslmode=require
# Pasta do banco local embutido e dos arquivos JSON antigos (opcional)
# DATA_DIR=./src/data
