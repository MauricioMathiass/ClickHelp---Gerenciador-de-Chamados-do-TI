# Endereço da API. Deixe "/api": o Vite repassa as chamadas para o backend,
# o que funciona na sua máquina, no GitHub Codespaces e em servidores.
# Só troque se o backend estiver em outro domínio (ex.: https://api.suaempresa.com/api).
VITE_API_URL=/api
# Para onde o Vite repassa o "/api" (padrão: http://localhost:3001)
# API_PROXY_TARGET=http://localhost:3001
# EmailJS (opcional): envia e-mail a cada novo chamado
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_NOTIFICATION_EMAIL_TO=seu-email@exemplo.com
